// ——— Shared bits ————————————————————————————————————————————————————

// The animated 3-bar now-playing indicator (pure markup animation).
component EqBars inherits Rectangle {
    HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        cross-axis-alignment: end;
        spacing: 2px;
        Rectangle {
            property <length> target: 5px;
            width: 3px;
            height: target;
            border-radius: 1px;
            background: Zt.primary;
            animate height { duration: 430ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
            init => { target = 12px; }
        }
        Rectangle {
            property <length> target: 5px;
            width: 3px;
            height: target;
            border-radius: 1px;
            background: Zt.primary;
            animate height { duration: 520ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
            init => { target = 6px; }
        }
        Rectangle {
            property <length> target: 5px;
            width: 3px;
            height: target;
            border-radius: 1px;
            background: Zt.primary;
            animate height { duration: 610ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
            init => { target = 10px; }
        }
    }
}

// The 52px track row used by every list.
component TrackRowUi inherits Rectangle {
    in property <TrackRow> data;
    in property <int> index;
    in property <int> current-id: -1;
    in property <bool> playing: false;
    in property <int> selected-index: -1;
    callback play-from(int);
    callback toggle-like(int);

    property <bool> is-current: root.data.id == current-id;
    property <bool> is-playing: is-current && playing;
    property <bool> is-selected: index == selected-index;

    height: 52px;
    border-radius: 8px;
    background: is-selected ? Zt.row-selected :
                is-current ? Zt.row-playing :
                ta.has-hover ? Zt.card : transparent;
    animate background { duration: 120ms; }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.play-from(root.index); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 16px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 12px;
        cross-axis-alignment: center;

        // index / bars / play glyph
        Rectangle {
            width: 24px;
            height: 100%;
            if root.is-playing : EqBars { x: 0; y: (parent.height - self.height) / 2; width: 100%; height: 14px; }
            if root.is-current && !root.is-playing : IcPlay { width: 14px; height: 14px; c: Zt.primary; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            if !root.is-current : Text {
                text: root.index + 1;
                color: Zt.muted-fg;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // artwork
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 4px;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.data.art;
                image-fit: cover;
            }
        }

        // title + artist
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                cross-axis-alignment: center;
                Text {
                    text: root.data.title;
                    color: Zt.fg;
                    font-size: 14px;
                    font-weight: 500;
                    overflow: elide;
                }
                if root.data.explicit : Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 2px;
                    background: Zt.muted;
                    Text {
                        text: "E";
                        color: Zt.muted-fg;
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
            Text {
                text: root.data.artist;
                color: Zt.muted-fg;
                font-size: 12px;
                overflow: elide;
            }
        }

        // duration or liked heart
        Rectangle {
            width: 40px;
            height: 100%;
            if root.data.liked : heart-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.toggle-like(root.data.id); }
                IcHeartActive {
                    width: 14px;
                    height: 14px;
                    c: Zt.primary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            if !root.data.liked : Text {
                text: root.data.duration;
                color: Zt.muted-fg;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }
}

// 176px card with hover scrim + red play pill.
component AlbumCard inherits Rectangle {
    in property <CardData> card;
    callback click();
    callback art-wanted();

    property <bool> hovered: touch.has-hover;

    width: 176px;
    height: 224px;
    border-radius: 8px;
    background: hovered ? Zt.card : transparent;
    animate background { duration: 120ms; }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.click(); }
    }

    init => { root.art-wanted(); }

    VerticalLayout {
        spacing: 6px;

        Rectangle {
            height: 176px;
            border-radius: root.card.round ? 88px : 4px;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.card.art;
                image-fit: cover;
            }
            if root.hovered : Rectangle {
                width: 100%;
                height: 100%;
                border-radius: root.card.round ? 88px : 4px;
                background: Zt.bg;
                opacity: 0.5;
                animate opacity { duration: 150ms; }
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: Zt.primary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    IcPlay {
                        width: 20px;
                        height: 20px;
                        c: white;
                        x: (parent.width - self.width) / 2 + 1px;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
        Text {
            text: root.card.title;
            color: Zt.fg;
            font-size: 14px;
            font-weight: 500;
            overflow: elide;
        }
        Text {
            text: root.card.subtitle;
            color: Zt.muted-fg;
            font-size: 12px;
            overflow: elide;
        }
    }
}

// Horizontal shelf of cards (h2 + scrollable row).
component Shelf inherits Rectangle {
    in property <string> title;
    in property <[CardData]> cards;
    callback card-click(kind: int, id: int);

    height: 328px;

    VerticalLayout {
        spacing: 12px;
        Text {
            text: root.title;
            color: Zt.fg;
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.48px;
        }
        ScrollView {
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            height: 240px;
            HorizontalLayout {
                alignment: start;
                cross-axis-alignment: center;
                spacing: 16px;
                for c in root.cards : AlbumCard {
                    card: c;
                    click => { root.card-click(c.kind, c.id); }
                }
            }
        }
    }
}

// Virtualized grid: a ListView over row-chunks of cards (the 600-album grid).
component CardGrid inherits ListView {
    in property <[GridRow]> rows;
    callback card-click(kind: int, id: int);
    callback art-needed(row: int, col: int);

    for row[i] in root.rows : Rectangle {
        height: 232px;
        HorizontalLayout {
            alignment: start;
            cross-axis-alignment: center;
            padding-left: 4px;
            spacing: 16px;
            for c[j] in row.cards : AlbumCard {
                card: c;
                click => { root.card-click(c.kind, c.id); }
                art-wanted => { root.art-needed(i, j); }
            }
        }
    }
}

// Non-virtualized grid rows (small grids: home 24, artist 2-4).
component GridRows inherits Rectangle {
    in property <[GridRow]> rows;
    callback card-click(kind: int, id: int);
    callback art-needed(row: int, col: int);

    VerticalLayout {
        spacing: 16px;
        for row[i] in root.rows : HorizontalLayout {
            alignment: start;
            cross-axis-alignment: center;
            spacing: 16px;
            for c[j] in row.cards : AlbumCard {
                card: c;
                click => { root.card-click(c.kind, c.id); }
                art-wanted => { root.art-needed(i, j); }
            }
        }
    }
}

// Sidebar / library playlist row.
component PlaylistRowUi inherits Rectangle {
    in property <PlaylistRowData> data;
    in property <bool> active: false;
    callback open(int);

    property <bool> hovered: ta.has-hover;

    height: 48px;
    border-radius: 8px;
    background: active || hovered ? Zt.card : transparent;
    animate background { duration: 120ms; }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.open(root.data.id); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 10px;
        cross-axis-alignment: center;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 4px;
            clip: true;
            Image { width: 100%; height: 100%; source: root.data.art; image-fit: cover; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.data.title;
                color: Zt.fg;
                font-size: 13px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.data.sub;
                color: Zt.muted-fg;
                font-size: 12px;
                overflow: elide;
            }
        }
    }
}

// Library ▸ Artists root.data.
component ArtistRowUi inherits Rectangle {
    in property <ArtistRowData> data;
    callback open(int);

    property <bool> hovered: ta.has-hover;

    height: 52px;
    border-radius: 8px;
    background: hovered ? Zt.card : transparent;
    animate background { duration: 120ms; }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.open(root.data.id); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            clip: true;
            Image { width: 100%; height: 100%; source: root.data.art; image-fit: cover; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.data.name;
                color: Zt.fg;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.data.sub;
                color: Zt.muted-fg;
                font-size: 12px;
                overflow: elide;
            }
        }
    }
}

// Queue panel row (with region section header).
component QueueRowUi inherits Rectangle {
    in property <QueueRowData> data;
    callback jump(int);
    callback remove(int);

    property <bool> is-current: root.data.region == 1;
    property <bool> hovered: ta.has-hover;

    height: root.data.header != "" ? 70px : 48px;
    border-radius: 8px;
    background: is-current ? Zt.row-playing : hovered ? Zt.card : transparent;
    animate background { duration: 120ms; }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.jump(root.data.index); }
    }

    VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        if root.data.header != "" : Text {
            text: root.data.header;
            color: Zt.muted-fg;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
        }
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 10px;
            cross-axis-alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 4px;
                clip: true;
                Image { width: 100%; height: 100%; source: root.data.art; image-fit: cover; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.data.title;
                    color: Zt.fg;
                    font-size: 13px;
                    font-weight: 500;
                    overflow: elide;
                }
                Text {
                    text: root.data.artist;
                    color: Zt.muted-fg;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            Text {
                text: root.data.duration;
                color: Zt.muted-fg;
                font-size: 12px;
                width: 36px;
                horizontal-alignment: right;
            }
            if !root.is-current : rm := TouchArea {
                width: 24px;
                height: 24px;
                mouse-cursor: pointer;
                clicked => { root.remove(root.data.index); }
                IcClose {
                    width: 13px;
                    height: 13px;
                    c: rm.has-hover ? Zt.fg : Zt.muted-fg;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}

// Pill buttons.
component PrimaryPill inherits Rectangle {
    in property <string> label: "Play";
    callback click();

    height: 40px;
    width: 104px;
    border-radius: 999px;
    background: touch.has-hover ? #ff1a47 : Zt.primary;
    animate background { duration: 120ms; }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.click(); }
    }

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        spacing: 8px;
        IcPlay { width: 18px; height: 18px; c: white; }
        Text {
            text: root.label;
            color: white;
            font-size: 14px;
            font-weight: 500;
        }
    }
}

component GhostPill inherits Rectangle {
    in property <string> label: "Shuffle";
    callback click();

    height: 40px;
    width: 116px;
    border-radius: 999px;
    border-width: 1px;
    border-color: touch.has-hover ? Zt.fg : #3d3d3d;
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.click(); }
    }

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        spacing: 8px;
        IcShuffle { width: 16px; height: 16px; c: Zt.fg; }
        Text {
            text: root.label;
            color: Zt.fg;
            font-size: 14px;
            font-weight: 500;
        }
    }
}

// Library tab pill.
component TabPill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 32px;
    width: label-text.preferred-width + 30px;
    border-radius: 999px;
    background: active ? Zt.fg : ta.has-hover ? Zt.card : Zt.muted;
    animate background { duration: 120ms; }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    label-text := Text {
        text: root.label;
        color: active ? Zt.bg : Zt.fg;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// Seek bar (custom-styled; commit on release).
component SeekBar inherits Rectangle {
    in property <float> position;   // seconds
    in property <float> duration;    // seconds
    callback seek(f: float);

    property <bool> dragging: ta.pressed;
    property <float> drag-frac: 0;
    property <float> frac: dragging ? drag-frac : (duration > 0 ? position / duration : 0);

    height: 16px;

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        pointer-event(pe) => {
            if (pe.kind == PointerEventKind.down) {
                root.drag-frac = min(1, max(0, self.mouse-x / root.width));
            } else if (pe.kind == PointerEventKind.up && root.dragging) {
                root.seek(root.drag-frac * root.duration);
            }
        }
        moved => {
            if (root.dragging) {
                root.drag-frac = min(1, max(0, self.mouse-x / root.width));
            }
        }
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 4px;
        border-radius: 2px;
        background: Zt.seek-track;
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width * min(1, max(0, root.frac));
        height: 4px;
        border-radius: 2px;
        background: Zt.primary;
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Zt.fg;
        x: parent.width * min(1, max(0, root.frac)) - self.width / 2;
        y: (parent.height - self.height) / 2;
        visible: ta.has-hover || root.dragging;
    }
}

// Volume slider (live-apply).
component VolumeSlider inherits Rectangle {
    in property <float> volume;
    callback changed(f: float);

    property <bool> dragging: ta.pressed;
    property <float> drag-frac: 0;
    property <float> frac: dragging ? drag-frac : volume;

    width: 96px;
    height: 16px;

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        pointer-event(pe) => {
            if (pe.kind == PointerEventKind.down) {
                root.drag-frac = min(1, max(0, self.mouse-x / root.width));
                root.changed(root.drag-frac);
            }
        }
        moved => {
            if (root.dragging) {
                root.drag-frac = min(1, max(0, self.mouse-x / root.width));
                root.changed(root.drag-frac);
            }
        }
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 4px;
        border-radius: 2px;
        background: Zt.seek-track;
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width * min(1, max(0, root.frac));
        height: 4px;
        border-radius: 2px;
        background: Zt.fg;
    }
}

// Icon button (transport, like, queue, volume). The icon comes in as a child.
component IconButton inherits Rectangle {
    callback click();
    in property <length> icon-size: 18px;

    property <bool> hovered: ta.has-hover;
    background: hovered ? Zt.card : transparent;
    border-radius: 999px;
    width: icon-size + 16px;
    height: icon-size + 16px;

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.click(); }
    }
    @children
}

// ——— Sidebar ————————————————————————————————————————————————————————

component Sidebar inherits Rectangle {
    in property <PageTag> page;
    in property <bool> compact: false;
    in property <[PlaylistRowData]> playlists;
    in property <int> active-playlist: -1;
    callback nav-home();
    callback nav-search();
    callback nav-library();
    callback nav-settings();
    callback open-playlist(int);

    background: Zt.bg;

    VerticalLayout {
        padding-top: 14px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 2px;

        // Logo
        Rectangle {
            height: 40px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 7px;
                    background: Zt.primary;
                    Text {
                        text: "Z";
                        color: white;
                        font-size: 16px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
                if !root.compact : Text {
                    text: "Zuno";
                    color: Zt.fg;
                    font-size: 19px;
                    font-weight: 700;
                    letter-spacing: -0.4px;
                }
            }
        }
        Rectangle { height: 14px; }

        // Nav items
        nav-home := Rectangle {
            height: 36px;
            border-radius: 8px;
            property <bool> active: root.page == PageTag.home;
            background: active ? Zt.card : nav-home-ta.has-hover ? Zt.card : transparent;
            animate background { duration: 120ms; }
            nav-home-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.nav-home(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 12px;
                alignment: start;
                cross-axis-alignment: center;
                IcHome { width: 19px; height: 19px; c: active ? Zt.fg : Zt.muted-fg; }
                if !root.compact : Text {
                    text: "Home";
                    color: active ? Zt.fg : Zt.muted-fg;
                    font-size: 14px;
                    font-weight: 500;
                }
            }
        }
        nav-search := Rectangle {
            height: 36px;
            border-radius: 8px;
            property <bool> active: root.page == PageTag.search;
            background: active ? Zt.card : nav-search-ta.has-hover ? Zt.card : transparent;
            animate background { duration: 120ms; }
            nav-search-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.nav-search(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 12px;
                alignment: start;
                cross-axis-alignment: center;
                IcSearch { width: 19px; height: 19px; c: active ? Zt.fg : Zt.muted-fg; }
                if !root.compact : Text {
                    text: "Search";
                    color: active ? Zt.fg : Zt.muted-fg;
                    font-size: 14px;
                    font-weight: 500;
                }
            }
        }
        nav-library := Rectangle {
            height: 36px;
            border-radius: 8px;
            property <bool> active: root.page == PageTag.library;
            background: active ? Zt.card : nav-library-ta.has-hover ? Zt.card : transparent;
            animate background { duration: 120ms; }
            nav-library-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.nav-library(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 12px;
                alignment: start;
                cross-axis-alignment: center;
                IcLibrary { width: 19px; height: 19px; c: active ? Zt.fg : Zt.muted-fg; }
                if !root.compact : Text {
                    text: "Library";
                    color: active ? Zt.fg : Zt.muted-fg;
                    font-size: 14px;
                    font-weight: 500;
                }
            }
        }
        nav-settings := Rectangle {
            height: 36px;
            border-radius: 8px;
            property <bool> active: root.page == PageTag.settings;
            background: active ? Zt.card : nav-settings-ta.has-hover ? Zt.card : transparent;
            animate background { duration: 120ms; }
            nav-settings-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.nav-settings(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 12px;
                alignment: start;
                cross-axis-alignment: center;
                IcSettings { width: 19px; height: 19px; c: active ? Zt.fg : Zt.muted-fg; }
                if !root.compact : Text {
                    text: "Settings";
                    color: active ? Zt.fg : Zt.muted-fg;
                    font-size: 14px;
                    font-weight: 500;
                }
            }
        }

        Rectangle { height: 18px; }
        if !root.compact : Text {
            text: "PLAYLISTS";
            color: Zt.muted-fg;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
        }
        Rectangle { height: 6px; }

        ScrollView {
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
                spacing: 1px;
                for p in root.playlists : PlaylistRowUi {
                    data: p;
                    active: p.id == root.active-playlist;
                    open(id) => { root.open-playlist(p.id); }
                }
            }
        }
    }
}

// ——— Home ——————————————————————————————————————————————————————————

component HomePage inherits Rectangle {
    in property <[CardData]> recent;
    in property <[CardData]> mixes;
    in property <[GridRow]> new-rows;
    in property <[CardData]> artists;
    callback card-click(kind: int, id: int);
    callback art-needed(row: int, col: int);

    background: Zt.bg;

    ScrollView {
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 24px;
            padding-bottom: 24px;
            spacing: 24px;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Home";
                    color: Zt.fg;
                    font-size: 32px;
                    font-weight: 700;
                    letter-spacing: -0.96px;
                }
                Text {
                    text: "Pick up where you left off";
                    color: Zt.muted-fg;
                    font-size: 12px;
                }
            }
            Shelf {
                title: "Recently played";
                cards: root.recent;
                card-click(k, id) => { root.card-click(k, id); }
            }
            Shelf {
                title: "Made for you";
                cards: root.mixes;
                card-click(k, id) => { root.card-click(k, id); }
            }
            VerticalLayout {
                spacing: 12px;
                Text {
                    text: "New albums";
                    color: Zt.fg;
                    font-size: 24px;
                    font-weight: 700;
                    letter-spacing: -0.48px;
                }
                GridRows {
                    rows: root.new-rows;
                    card-click(k, id) => { root.card-click(k, id); }
                    art-needed(r, c) => { root.art-needed(r, c); }
                }
            }
            Shelf {
                title: "Popular artists";
                cards: root.artists;
                card-click(k, id) => { root.card-click(k, id); }
            }
        }
    }
}

// ——— Library (the 5,000-row list lives here) ————————————————————————

component LibraryPage inherits Rectangle {
    in property <int> tab;             // 0 playlists · 1 albums · 2 artists · 3 songs
    in property <[TrackRow]> songs;
    in property <[PlaylistRowData]> playlists;
    in property <[ArtistRowData]> artists;
    in property <[GridRow]> album-rows;
    in property <bool> can-go-back: false;
    in property <int> current-id: -1;
    in property <bool> playing: false;
    in property <int> selected-index: -1;
    callback back();
    callback set-tab(int);
    callback play-from(int);
    callback toggle-like(int);
    callback open-playlist(int);
    callback open-artist(int);
    callback open-album(int);
    callback card-art-needed(row: int, col: int);

    background: Zt.bg;

    // The bench's scroll driver: hard jump to a fraction of the list, no easing.
    public function scroll-frac(f: float) {
        songs-list.content-y = f * (songs-list.content-height - songs-list.visible-height);
    }

    VerticalLayout {
        // Header
        Rectangle {
            height: 62px;
            HorizontalLayout {
                padding-left: 12px;
                spacing: 12px;
                alignment: start;
                cross-axis-alignment: center;
                if root.can-go-back : IconButton {
                    icon-size: 20px;
                    click => { root.back(); }
                    IcBack { width: 20px; height: 20px; c: Zt.muted-fg; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
                Text {
                    text: "Your Library";
                    color: Zt.fg;
                    font-size: 32px;
                    font-weight: 700;
                    letter-spacing: -0.96px;
                }
            }
        }
        // Tabs
        Rectangle {
            height: 44px;
            HorizontalLayout {
                padding-left: 12px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;
                TabPill { label: "Playlists"; active: root.tab == 0; clicked => { root.set-tab(0); } }
                TabPill { label: "Albums"; active: root.tab == 1; clicked => { root.set-tab(1); } }
                TabPill { label: "Artists"; active: root.tab == 2; clicked => { root.set-tab(2); } }
                TabPill { label: "Songs"; active: root.tab == 3; clicked => { root.set-tab(3); } }
            }
        }
        // Body
        Rectangle {
            if root.tab == 0 : ScrollView {
                x: 0; y: 0; width: 100%; height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 2px;
                    for p in root.playlists : PlaylistRowUi {
                        data: p;
                        open(id) => { root.open-playlist(p.id); }
                    }
                }
            }
            if root.tab == 1 : CardGrid {
                x: 0; y: 0; width: 100%; height: 100%;
                rows: root.album-rows;
                card-click(k, id) => { root.open-album(id); }
                art-needed(r, c) => { root.card-art-needed(r, c); }
            }
            if root.tab == 2 : ScrollView {
                x: 0; y: 0; width: 100%; height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 2px;
                    for a in root.artists : ArtistRowUi {
                        data: a;
                        open(id) => { root.open-artist(a.id); }
                    }
                }
            }
            songs-list := ListView {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                visible: root.tab == 3;
                for tr[i] in root.songs : TrackRowUi {
                    data: tr;
                    index: i;
                    current-id: root.current-id;
                    playing: root.playing;
                    selected-index: root.selected-index;
                    play-from(ix) => { root.play-from(ix); }
                    toggle-like(id) => { root.toggle-like(id); }
                }
            }
        }
    }
}

// ——— Album / Playlist / Artist detail ————————————————————————————————

component DetailPage inherits Rectangle {
    in property <image> hero-art;
    in property <bool> hero-round: false;
    in property <string> hero-kind;
    in property <string> hero-title;
    in property <string> hero-sub;
    in property <string> hero-counts;
    in property <bool> is-artist: false;
    in property <[TrackRow]> tracks;
    in property <[GridRow]> album-rows;
    in property <int> current-id: -1;
    in property <bool> playing: false;
    in property <int> selected-index: -1;
    callback play-all();
    callback shuffle-play();
    callback play-from(int);
    callback toggle-like(int);
    callback open-album(int);
    callback art-needed(row: int, col: int);

    background: Zt.bg;

    ScrollView {
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 24px;
            padding-bottom: 24px;
            spacing: 20px;

            // Hero
            HorizontalLayout {
                spacing: 24px;
                cross-axis-alignment: center;
                Rectangle {
                    width: 232px;
                    height: 232px;
                    border-radius: root.hero-round ? 116px : 4px;
                    clip: true;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.hero-art;
                        image-fit: cover;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: root.hero-kind;
                        color: Zt.muted-fg;
                        font-size: 12px;
                    }
                    Text {
                        text: root.hero-title;
                        color: Zt.fg;
                        font-size: 32px;
                        font-weight: 700;
                        letter-spacing: -0.96px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.hero-sub;
                        color: Zt.muted-fg;
                        font-size: 12px;
                    }
                    Text {
                        text: root.hero-counts;
                        color: Zt.muted-fg;
                        font-size: 12px;
                    }
                    Rectangle { height: 8px; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        cross-axis-alignment: center;
                        PrimaryPill { label: "Play"; click => { root.play-all(); } }
                        GhostPill { label: "Shuffle"; click => { root.shuffle-play(); } }
                    }
                }
            }

            // Collection: the full track list.
            if !root.is-artist : VerticalLayout {
                spacing: 1px;
                for tr[i] in root.tracks : TrackRowUi {
                    data: tr;
                    index: i;
                    current-id: root.current-id;
                    playing: root.playing;
                    selected-index: root.selected-index;
                    play-from(ix) => { root.play-from(ix); }
                    toggle-like(id) => { root.toggle-like(id); }
                }
            }
            // Artist: top tracks + albums grid.
            if root.is-artist : VerticalLayout {
                spacing: 20px;
                Text {
                    text: "Top tracks";
                    color: Zt.fg;
                    font-size: 24px;
                    font-weight: 700;
                    letter-spacing: -0.48px;
                }
                VerticalLayout {
                    spacing: 1px;
                    for tr[i] in root.tracks : TrackRowUi {
                        data: tr;
                        index: i;
                        current-id: root.current-id;
                        playing: root.playing;
                        selected-index: root.selected-index;
                        play-from(ix) => { root.play-from(ix); }
                        toggle-like(id) => { root.toggle-like(id); }
                    }
                }
                Text {
                    text: "Albums";
                    color: Zt.fg;
                    font-size: 24px;
                    font-weight: 700;
                    letter-spacing: -0.48px;
                }
                GridRows {
                    rows: root.album-rows;
                    card-click(k, id) => { root.open-album(id); }
                    art-needed(r, c) => { root.art-needed(r, c); }
                }
            }
        }
    }
}

// ——— Search ————————————————————————————————————————————————————————

component SearchPage inherits Rectangle {
    in-out property <string> query-text;
    in property <bool> has-query: false;
    in property <[CardData]> top;
    in property <[TrackRow]> songs;
    in property <[CardData]> albums;
    in property <[CardData]> artists;
    in property <int> current-id: -1;
    in property <bool> playing: false;
    in property <int> selected-index: -1;
    callback search-edited(string);
    callback card-click(kind: int, id: int);
    callback play-from(int);
    callback toggle-like(int);

    background: Zt.bg;

    public function focus-input() {
        fs.focus();
    }

    ScrollView {
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 24px;
            padding-bottom: 24px;
            spacing: 20px;

            Rectangle {
                width: 440px;
                height: 42px;
                fs := FocusScope {
                    width: 100%;
                    height: 100%;
                    forward-focus: input;
                    input := LineEdit {
                        width: 100%;
                        height: 100%;
                        placeholder-text: "Search songs, albums, artists…";
                        text <=> root.query-text;
                        font-size: 14px;
                        edited(t) => { root.search-edited(t); }
                    }
                }
            }

            if !root.has-query : Text {
                text: "Search filters all 5,000 tracks as you type. Press Ctrl+K anywhere.";
                color: Zt.muted-fg;
                font-size: 14px;
            }

            if root.has-query && root.songs.length == 0 : Text {
                text: "No results for \"" + root.query-text + "\"";
                color: Zt.muted-fg;
                font-size: 14px;
            }

            if root.has-query && root.songs.length > 0 : VerticalLayout {
                spacing: 24px;
                VerticalLayout {
                    spacing: 12px;
                    Text {
                        text: "Top result";
                        color: Zt.fg;
                        font-size: 24px;
                        font-weight: 700;
                        letter-spacing: -0.48px;
                    }
                    Rectangle {
                        height: 224px;
                        for c in root.top : AlbumCard {
                            x: 0; y: 0;
                            card: c;
                            click => { root.card-click(c.kind, c.id); }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 12px;
                    Text {
                        text: "Songs";
                        color: Zt.fg;
                        font-size: 24px;
                        font-weight: 700;
                        letter-spacing: -0.48px;
                    }
                    VerticalLayout {
                        spacing: 1px;
                        for tr[i] in root.songs : TrackRowUi {
                            data: tr;
                            index: i;
                            current-id: root.current-id;
                            playing: root.playing;
                            selected-index: root.selected-index;
                            play-from(ix) => { root.play-from(ix); }
                            toggle-like(id) => { root.toggle-like(id); }
                        }
                    }
                }
                if root.albums.length > 0 : Shelf {
                    title: "Albums";
                    cards: root.albums;
                    card-click(k, id) => { root.card-click(k, id); }
                }
                if root.artists.length > 0 : Shelf {
                    title: "Artists";
                    cards: root.artists;
                    card-click(k, id) => { root.card-click(k, id); }
                }
            }
        }
    }
}

// ——— Settings ———————————————————————————————————————————————————————

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 44px;
    border-radius: 8px;
    background: Zt.muted;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            color: Zt.fg;
            font-size: 14px;
            font-weight: 500;
        }
        Text {
            text: root.value;
            color: Zt.muted-fg;
            font-size: 12px;
            horizontal-alignment: right;
            width: 100%;
        }
    }
}

component SettingsPage inherits Rectangle {
    background: Zt.bg;
    ScrollView {
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 24px;
            padding-bottom: 24px;
            spacing: 24px;

            Text {
                text: "Settings";
                color: Zt.fg;
                font-size: 32px;
                font-weight: 700;
                letter-spacing: -0.96px;
            }
            VerticalLayout {
                spacing: 10px;
                Text {
                    text: "Appearance";
                    color: Zt.fg;
                    font-size: 18px;
                    font-weight: 600;
                }
                SettingRow { label: "Theme"; value: "Dark (pinned)"; }
                SettingRow { label: "Accent"; value: "#FF0033"; }
            }
            VerticalLayout {
                spacing: 10px;
                Text {
                    text: "Playback";
                    color: Zt.fg;
                    font-size: 18px;
                    font-weight: 600;
                }
                SettingRow { label: "Streaming quality"; value: "High (256 kbps)"; }
                SettingRow { label: "Download quality"; value: "High (256 kbps)"; }
                SettingRow { label: "Gapless playback"; value: "On"; }
                SettingRow { label: "Crossfade"; value: "Off"; }
                SettingRow { label: "Audio engine"; value: "Rust (cpal) — no WebView"; }
            }
            VerticalLayout {
                spacing: 10px;
                Text {
                    text: "Library";
                    color: Zt.fg;
                    font-size: 18px;
                    font-weight: 600;
                }
                SettingRow { label: "Cache"; value: "4 GB"; }
                SettingRow { label: "Downloads ceiling"; value: "8 GB"; }
            }
        }
    }
}

// ——— Queue panel ————————————————————————————————————————————————————

component QueuePanel inherits Rectangle {
    in property <[QueueRowData]> rows;
    callback close();
    callback jump(int);
    callback remove(int);

    width: 300px;
    background: Zt.popover;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000a0;
    drop-shadow-offset-y: 0;

    VerticalLayout {
        padding-top: 14px;
        padding-left: 16px;
        padding-right: 12px;
        padding-bottom: 12px;
        spacing: 8px;

        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            cross-axis-alignment: center;
            Text {
                text: "Queue";
                color: Zt.fg;
                font-size: 18px;
                font-weight: 600;
            }
            Rectangle { width: 8px; }
            IconButton {
                icon-size: 16px;
                click => { root.close(); }
                IcClose { width: 16px; height: 16px; c: Zt.muted-fg; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
        }

        ListView {
            for qr in root.rows : QueueRowUi {
                data: qr;
                jump(ix) => { root.jump(ix); }
                remove(ix) => { root.remove(ix); }
            }
        }
    }
}

// ——— Player bar ————————————————————————————————————————————————————

component PlayerBar inherits Rectangle {
    in property <bool> playing: false;
    in property <bool> has-track: false;
    in property <int> current-id: -1;
    in property <string> pb-title;
    in property <string> pb-artist;
    in property <image> pb-art;
    in property <int> pb-album-id: -1;
    in property <int> pb-artist-id: -1;
    in property <bool> pb-liked: false;
    in property <float> position: 0;
    in property <float> track-duration: 1;
    in property <string> position-label: "0:00";
    in property <string> duration-label: "0:00";
    in property <bool> shuffle: false;
    in property <int> repeat: 0;      // 0 off · 1 all · 2 one
    in property <bool> muted: false;
    in property <float> volume: 1;
    in property <bool> queue-open: false;

    callback toggle-play();
    callback next();
    callback prev();
    callback seek-to(f: float);
    callback seek-by(d: float);
    callback set-volume(f: float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-like();
    callback toggle-queue();
    callback open-album(int);
    callback open-artist(int);

    height: 76px;
    background: Zt.bg;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 12px;
        spacing: 12px;
        cross-axis-alignment: center;

        // Left: artwork + title/artist
        HorizontalLayout {
            alignment: start;
            cross-axis-alignment: center;
            spacing: 12px;
            horizontal-stretch: 10;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 4px;
                clip: true;
                Image { width: 100%; height: 100%; source: root.pb-art; image-fit: cover; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Rectangle {
                    height: 20px;
                    width: 220px;
                    t1 := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { if (root.has-track) { root.open-album(root.pb-album-id); } }
                    }
                    Text {
                        text: root.pb-title;
                        color: Zt.fg;
                        font-size: 14px;
                        font-weight: 500;
                        overflow: elide;
                        width: 100%;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 18px;
                    width: 220px;
                    t2 := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { if (root.has-track) { root.open-artist(root.pb-artist-id); } }
                    }
                    Text {
                        text: root.pb-artist;
                        color: Zt.muted-fg;
                        font-size: 12px;
                        overflow: elide;
                        width: 100%;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Center: transport + seek
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            width: 360px;
            HorizontalLayout {
                height: 40px;
                alignment: center;
                cross-axis-alignment: center;
                spacing: 6px;
                IconButton {
                    icon-size: 18px;
                    click => { root.toggle-shuffle(); }
                    IcShuffle { width: 18px; height: 18px; c: root.shuffle ? Zt.primary : Zt.muted-fg; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
                IconButton {
                    icon-size: 20px;
                    click => { root.prev(); }
                    IcPrev { width: 20px; height: 20px; c: Zt.fg; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
                play-btn := Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 999px;
                    background: play-ta.has-hover ? #ff1a47 : Zt.primary;
                    animate background { duration: 120ms; }
                    play-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.toggle-play(); }
                    }
                    if root.playing : IcPause {
                        width: 20px;
                        height: 20px;
                        c: white;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    if !root.playing : IcPlay {
                        width: 20px;
                        height: 20px;
                        c: white;
                        x: (parent.width - self.width) / 2 + 1px;
                        y: (parent.height - self.height) / 2;
                    }
                }
                IconButton {
                    icon-size: 20px;
                    click => { root.next(); }
                    IcNext { width: 20px; height: 20px; c: Zt.fg; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
                IconButton {
                    icon-size: 18px;
                    click => { root.cycle-repeat(); }
                    if root.repeat == 2 : IcRepeatOne {
                        width: 18px; height: 18px;
                        c: Zt.primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    if root.repeat != 2 : IcRepeat {
                        width: 18px; height: 18px;
                        c: root.repeat != 0 ? Zt.primary : Zt.muted-fg;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            HorizontalLayout {
                height: 18px;
                spacing: 10px;
                cross-axis-alignment: center;
                Text {
                    text: root.position-label;
                    color: Zt.muted-fg;
                    font-size: 12px;
                    width: 40px;
                    horizontal-alignment: right;
                }
                SeekBar {
                    position: root.position;
                    duration: root.track-duration;
                    seek(f) => { root.seek-to(f); }
                }
                Text {
                    text: root.duration-label;
                    color: Zt.muted-fg;
                    font-size: 12px;
                    width: 40px;
                }
            }
        }

        // Right: like, queue, volume
        HorizontalLayout {
            alignment: end;
            cross-axis-alignment: center;
            spacing: 4px;
            horizontal-stretch: 10;
            IconButton {
                icon-size: 18px;
                click => { root.toggle-like(); }
                if root.pb-liked : IcHeartActive {
                    width: 18px; height: 18px; c: Zt.primary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                if !root.pb-liked : IcHeart {
                    width: 18px; height: 18px; c: Zt.muted-fg;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            IconButton {
                icon-size: 18px;
                click => { root.toggle-queue(); }
                IcQueue {
                    width: 18px; height: 18px;
                    c: root.queue-open ? Zt.primary : Zt.muted-fg;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            IconButton {
                icon-size: 18px;
                click => { root.toggle-mute(); }
                if root.muted || root.volume < 0.01 : IcVolumeMute {
                    width: 18px; height: 18px; c: Zt.muted-fg;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                if !(root.muted || root.volume < 0.01) : IcVolume {
                    width: 18px; height: 18px; c: Zt.muted-fg;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            VolumeSlider {
                volume: root.volume;
                changed(f) => { root.set-volume(f); }
            }
        }
    }
}

// ——— Root window ————————————————————————————————————————————————————

export component ZunoWindow inherits Window {
    title: "Zuno";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Zt.bg;
    default-font-family: "Inter";

    init => { Palette.color-scheme = ColorScheme.dark; }

    // ——— navigation ———
    in-out property <PageTag> page: PageTag.home;
    in property <bool> compact: false;
    in property <bool> can-go-back: false;
    in property <bool> queue-open: false;
    in property <int> library-tab: 3;
    in property <int> active-playlist: -1;

    // ——— home ———
    in property <[CardData]> home-recent;
    in property <[CardData]> home-mixes;
    in property <[GridRow]> home-new-rows;
    in property <[CardData]> home-artists;

    // ——— sidebar / library ———
    in property <[PlaylistRowData]> sidebar-playlists;
    in property <[PlaylistRowData]> lib-playlists;
    in property <[ArtistRowData]> lib-artists;
    in property <[GridRow]> lib-album-rows;
    in property <[TrackRow]> songs;

    // ——— detail pages ———
    in property <image> hero-art;
    in property <bool> hero-round: false;
    in property <string> hero-kind;
    in property <string> hero-title;
    in property <string> hero-sub;
    in property <string> hero-counts;
    in property <bool> hero-is-artist: false;
    in property <[TrackRow]> page-tracks;
    in property <[GridRow]> artist-album-rows;

    // ——— search ———
    in-out property <string> search-query: "";
    in property <bool> search-has-query: false;
    in property <[CardData]> search-top;
    in property <[TrackRow]> search-songs;
    in property <[CardData]> search-albums;
    in property <[CardData]> search-artists;

    // ——— queue ———
    in property <[QueueRowData]> queue-rows;

    // ——— player ———
    in property <bool> playing: false;
    in property <bool> has-track: false;
    in property <int> current-id: -1;
    in property <string> pb-title: "Nothing playing";
    in property <string> pb-artist: "—";
    in property <image> pb-art;
    in property <int> pb-album-id: -1;
    in property <int> pb-artist-id: -1;
    in property <bool> pb-liked: false;
    in property <float> position: 0;
    in property <float> track-duration: 1;
    in property <string> position-label: "0:00";
    in property <string> duration-label: "0:00";
    in property <bool> shuffle: false;
    in property <int> repeat: 0;
    in property <bool> muted: false;
    in property <float> volume: 1;

    // ——— selection (bench + UI) ———
    in property <int> selected-index: -1;

    // ——— callbacks to Rust ———
    callback nav-home();
    callback nav-search();
    callback nav-library();
    callback nav-settings();
    callback open-album(int);
    callback open-artist(int);
    callback open-playlist(int);
    callback card-click(kind: int, id: int);
    callback set-tab(int);
    callback search-edited(string);
    callback play-from(int);
    callback shuffle-play();
    callback play-all();
    callback toggle-like(int);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback seek-to(f: float);
    callback seek-by(d: float);
    callback set-volume(f: float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-queue();
    callback queue-jump(int);
    callback queue-remove(int);
    callback go-back();
    callback escape();
    callback ctrl-k();
    callback card-art-home(row: int, col: int);
    callback card-art-library(row: int, col: int);
    callback card-art-artist(row: int, col: int);

    // ——— public functions (Rust → markup) ———
    public function bench-scroll(frac: float) {
        lib.scroll-frac(frac);
    }
    public function focus-search-field() {
        search.focus-input();
    }

    keyscope := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "k" || event.text == "K")) {
                root.ctrl-k();
                return accept;
            }
            if (event.text == "/") {
                root.ctrl-k();
                return accept;
            }
            if (event.text == Key.Space) {
                root.toggle-play();
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.seek-by(10);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.seek-by(-10);
                return accept;
            }
            if (event.text == Key.Escape) {
                root.escape();
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                root.toggle-mute();
                return accept;
            }
            if (event.text == "q" || event.text == "Q") {
                root.toggle-queue();
                return accept;
            }
            if (event.text == "s" || event.text == "S") {
                root.toggle-shuffle();
                return accept;
            }
            if (event.text == "r" || event.text == "R") {
                root.cycle-repeat();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        Sidebar {
            width: root.compact ? 62px : 220px;
            compact: root.compact;
            page: root.page;
            playlists: root.sidebar-playlists;
            active-playlist: root.active-playlist;
            nav-home => { root.nav-home(); }
            nav-search => { root.nav-search(); }
            nav-library => { root.nav-library(); }
            nav-settings => { root.nav-settings(); }
            open-playlist(id) => { root.open-playlist(id); }
        }

        VerticalLayout {
            content := Rectangle {
                clip: true;

                if root.page == PageTag.home : HomePage {
                    x: 0; y: 0; width: 100%; height: 100%;
                    recent: root.home-recent;
                    mixes: root.home-mixes;
                    new-rows: root.home-new-rows;
                    artists: root.home-artists;
                    card-click(k, id) => { root.card-click(k, id); }
                    art-needed(r, c) => { root.card-art-home(r, c); }
                }

                lib := LibraryPage {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.page == PageTag.library;
                    tab: root.library-tab;
                    songs: root.songs;
                    playlists: root.lib-playlists;
                    artists: root.lib-artists;
                    album-rows: root.lib-album-rows;
                    can-go-back: root.can-go-back;
                    current-id: root.current-id;
                    playing: root.playing;
                    selected-index: root.selected-index;
                    back => { root.go-back(); }
                    set-tab(ix) => { root.set-tab(ix); }
                    play-from(ix) => { root.play-from(ix); }
                    toggle-like(id) => { root.toggle-like(id); }
                    open-playlist(id) => { root.open-playlist(id); }
                    open-artist(id) => { root.open-artist(id); }
                    open-album(id) => { root.open-album(id); }
                    card-art-needed(r, c) => { root.card-art-library(r, c); }
                }

                if root.page == PageTag.album || root.page == PageTag.playlist || root.page == PageTag.artist : DetailPage {
                    x: 0; y: 0; width: 100%; height: 100%;
                    hero-art: root.hero-art;
                    hero-round: root.hero-round;
                    hero-kind: root.hero-kind;
                    hero-title: root.hero-title;
                    hero-sub: root.hero-sub;
                    hero-counts: root.hero-counts;
                    is-artist: root.hero-is-artist;
                    tracks: root.page-tracks;
                    album-rows: root.artist-album-rows;
                    current-id: root.current-id;
                    playing: root.playing;
                    selected-index: root.selected-index;
                    play-all => { root.play-all(); }
                    shuffle-play => { root.shuffle-play(); }
                    play-from(ix) => { root.play-from(ix); }
                    toggle-like(id) => { root.toggle-like(id); }
                    open-album(id) => { root.open-album(id); }
                    art-needed(r, c) => { root.card-art-artist(r, c); }
                }

                search := SearchPage {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.page == PageTag.search;
                    query-text <=> root.search-query;
                    has-query: root.search-has-query;
                    top: root.search-top;
                    songs: root.search-songs;
                    albums: root.search-albums;
                    artists: root.search-artists;
                    current-id: root.current-id;
                    playing: root.playing;
                    selected-index: root.selected-index;
                    search-edited(t) => { root.search-edited(t); }
                    card-click(k, id) => { root.card-click(k, id); }
                    play-from(ix) => { root.play-from(ix); }
                    toggle-like(id) => { root.toggle-like(id); }
                }

                if root.page == PageTag.settings : SettingsPage {
                    x: 0; y: 0; width: 100%; height: 100%;
                }

                if root.queue-open : QueuePanel {
                    x: parent.width - self.width;
                    y: 0;
                    height: 100%;
                    rows: root.queue-rows;
                    close => { root.toggle-queue(); }
                    jump(ix) => { root.queue-jump(ix); }
                    remove(ix) => { root.queue-remove(ix); }
                }
            }

            PlayerBar {
                playing: root.playing;
                has-track: root.has-track;
                current-id: root.current-id;
                pb-title: root.pb-title;
                pb-artist: root.pb-artist;
                pb-art: root.pb-art;
                pb-album-id: root.pb-album-id;
                pb-artist-id: root.pb-artist-id;
                pb-liked: root.pb-liked;
                position: root.position;
                track-duration: root.track-duration;
                position-label: root.position-label;
                duration-label: root.duration-label;
                shuffle: root.shuffle;
                repeat: root.repeat;
                muted: root.muted;
                volume: root.volume;
                queue-open: root.queue-open;
                toggle-play => { root.toggle-play(); }
                next => { root.next-track(); }
                prev => { root.prev-track(); }
                seek-to(f) => { root.seek-to(f); }
                seek-by(d) => { root.seek-by(d); }
                set-volume(f) => { root.set-volume(f); }
                toggle-mute => { root.toggle-mute(); }
                toggle-shuffle => { root.toggle-shuffle(); }
                cycle-repeat => { root.cycle-repeat(); }
                toggle-like => { root.toggle-like(root.current-id); }
                toggle-queue => { root.toggle-queue(); }
                open-album(id) => { root.open-album(id); }
                open-artist(id) => { root.open-artist(id); }
            }
        }
    }

    forward-focus: keyscope;
}
