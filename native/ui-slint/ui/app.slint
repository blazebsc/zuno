// Zuno — Slint implementation of the native-GUI benchmark (gui/slint).
// Renders the shared `zuno_core::AppState` per docs/gui-benchmarks/SPEC.md.
//
// The 5,000-row Library ▸ Songs list uses Slint's virtualized `ListView`
// (only visible delegates are instantiated) and is scrollable from Rust
// through `ListView.content-y` — see `ZunoWindow.bench-scroll` below.

import { ListView, ScrollView, LineEdit, Palette } from "std-widgets.slint";
import "../assets/Inter-Variable.ttf";

// ——— Design tokens (core::theme, dark palette) ——————————————————————

export global Zt {
    out property <color> bg: #0a0a0a;
    out property <color> fg: #fafafa;
    out property <color> card: #2a2a2a;
    out property <color> popover: #171717;
    out property <color> muted: #262626;
    out property <color> muted-fg: #a1a1a1;
    out property <color> primary: #ff0033;
    // primary at 5% / 10% over bg (core::theme::state)
    out property <color> row-playing: #160a0c;
    out property <color> row-selected: #22090e;
    out property <color> seek-track: #3a3a3a;
}

// ——— Data model structs ————————————————————————————————————————————

export enum PageTag { home, library, album, playlist, artist, search, settings }

export struct TrackRow {
    id: int,
    title: string,
    artist: string,
    duration: string,
    explicit: bool,
    liked: bool,
    art: image,
}

export struct CardData {
    id: int,
    kind: int,        // 0 album · 1 artist · 2 playlist · 3 track
    title: string,
    subtitle: string,
    round: bool,
    art: image,
    needs-art: bool,   // grids fill art lazily via the init callback
}

export struct GridRow {
    cards: [CardData],
}

export struct PlaylistRowData {
    id: int,
    title: string,
    sub: string,
    art: image,
}

export struct ArtistRowData {
    id: int,
    name: string,
    sub: string,
    art: image,
}

export struct QueueRowData {
    index: int,
    region: int,      // 0 played · 1 current · 2 manual · 3 automatic
    header: string,   // section label rendered on the first row of a region
    title: string,
    artist: string,
    duration: string,
    art: image,
}

